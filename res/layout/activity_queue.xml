<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="10dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="返回"
            android:src="@drawable/ic_back"
            android:tint="@color/text" />

        <TextView
            android:id="@+id/name"
            style="@style/TitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/btn_select"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="多选"
            android:src="@drawable/ic_check"
            android:tint="@color/text_sub" />

        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="清空队列"
            android:src="@drawable/ic_delete"
            android:tint="@color/text_sub" />

        <Button
            android:id="@+id/btn_delete_sel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/ripple_round"
            android:minWidth="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="删除"
            android:textAllCaps="false"
            android:textColor="@color/pink"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_cancel_sel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="取消多选"
            android:src="@drawable/ic_close"
            android:tint="@color/text"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="0.5dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="播放队列是空的\n在曲库里点「立即播放」或「播放全部」添加"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
