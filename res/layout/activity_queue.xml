<?xml version="1.0" encoding="utf-8"?>
<!-- 播放列表页：嵌入主界面（page_queue），与曲库/歌单同级 tab 页 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_queue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/name"
            style="@style/TitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/btn_select"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="多选"
            android:src="@drawable/ic_check"
            android:tint="@color/text_sub" />

        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="删除所选"
            android:src="@drawable/ic_delete"
            android:tint="@color/text_sub"
            android:enabled="false"
            android:alpha="0.35" />
    </LinearLayout>

    <!-- 队列多选操作栏（复用曲库逻辑：全选/反选/取消，默认隐藏） -->
    <LinearLayout
        android:id="@+id/queue_sel_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_queue_sel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/pink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_queue_sel_all"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/ripple_round"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/lib_sel_all"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_queue_sel_inv"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/ripple_round"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/lib_sel_inv"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_queue_cancel"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/ripple_round"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="取消"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="0.5dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="播放队列是空的\n在曲库里点「立即播放」或「播放全部」添加"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
