<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#86000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 封面上方一行：曲库入口 / 缓存 / 返回B站（同一风格） -->
        <LinearLayout
            android:id="@+id/row_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/back_box"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_round"
                android:minWidth="0dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/back"
                    android:drawableLeft="@drawable/ic_library"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_sub"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:text="曲库"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true" />
            </com.volcano.bmusic.ui.MarqueeView>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/btn_cache_box"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_round"
                android:minWidth="0dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/btn_cache"
                    android:drawableLeft="@drawable/ic_download"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_sub"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="缓存到本地"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true" />
            </com.volcano.bmusic.ui.MarqueeView>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/btn_bili_box"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_round"
                android:minWidth="0dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/btn_bili"
                    android:drawableLeft="@drawable/ic_bili"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_sub"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="返回 B 站"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true" />
            </com.volcano.bmusic.ui.MarqueeView>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <FrameLayout
            android:id="@+id/art_box"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_card"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />

            <TextView
                android:id="@+id/n_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_margin="8dp"
                android:background="@drawable/shape_card2"
                android:paddingBottom="3dp"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="3dp"
                android:text="P1"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="26dp"
            android:paddingRight="26dp">

            <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/title_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="未在播放"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" 
                android:singleLine="true" />
            </com.volcano.bmusic.ui.MarqueeView>

            <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/author_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text=""
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" 
                android:singleLine="true" />
            </com.volcano.bmusic.ui.MarqueeView>

            <LinearLayout
                android:id="@+id/row_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/t_cur"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/seek_gray"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <TextView
                    android:id="@+id/t_dur"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_ctrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_mode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="播放模式"
                    android:src="@drawable/ic_repeat"
                    android:tint="@color/text_sub" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:contentDescription="上一首"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:background="@drawable/circle_accent"
                    android:contentDescription="@string/play"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:contentDescription="下一首"
                    android:src="@drawable/ic_next"
                    android:tint="@color/text" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/btn_fav"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="收藏"
                    android:src="@drawable/ic_fav_border"
                    android:tint="@color/text_sub" />
            </LinearLayout>

            <!-- 下方一行：加入歌单 / 歌词 / 播放队列 -->
            <LinearLayout
                android:id="@+id/row_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/btn_queue_box"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.5"
                android:background="@drawable/ripple_round"
                android:minWidth="0dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/btn_queue"
                    android:drawableLeft="@drawable/ic_queue"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_sub"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/current_queue"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true" />
            </com.volcano.bmusic.ui.MarqueeView>

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/btn_add_pl_box"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_round"
                android:minWidth="0dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/btn_add_pl"
                    android:drawableLeft="@drawable/ic_add"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_sub"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="加入歌单"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true" />
            </com.volcano.bmusic.ui.MarqueeView>

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.volcano.bmusic.ui.MarqueeView
                android:id="@+id/btn_lyric_box"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/ripple_round"
                android:minWidth="0dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/btn_lyric"
                    android:drawableLeft="@drawable/ic_lyric"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_sub"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/lyrics"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true" />
            </com.volcano.bmusic.ui.MarqueeView>
            </LinearLayout>

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- vertical volume control (bar doubles as display + control) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/vol_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />

            <com.volcano.bmusic.ui.VolumeBar
                android:id="@+id/vol_bar"
                android:layout_width="44dp"
                android:layout_height="190dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/volume" />
        </LinearLayout>
    </FrameLayout>

    <!-- lyrics panel -->
    <FrameLayout
        android:id="@+id/lyric_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E612141C"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lyric_panel_title"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/lyric_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_sub"
                    android:contentDescription="关闭" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/lyric_query"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_card"
                    android:hint="@string/lyric_search_hint"
                    android:textColorHint="@color/text_dim"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/lyric_search"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/ripple_round"
                    android:text="@string/search"
                    android:textAllCaps="false"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lyric_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <ScrollView
                android:id="@+id/lyric_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/lyric_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="60dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
