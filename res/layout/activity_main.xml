<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ page: tracks ============ -->
        <LinearLayout
            android:id="@+id/page_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="8dp">

                <TextView
                    style="@style/TitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_tracks" />

                <ImageButton
                    android:id="@+id/btn_lib_select"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_dark"
                    android:contentDescription="@string/lib_select"
                    android:src="@drawable/ic_check"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btn_lib_clear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_dark"
                    android:contentDescription="@string/lib_clear"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/text" />

                <ImageButton
                    android:id="@+id/btn_add"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_dark"
                    android:contentDescription="@string/add_link"
                    android:src="@drawable/ic_add"
                    android:tint="@color/text" />
            </LinearLayout>

            <!-- 曲库多选操作栏（默认隐藏） -->
            <LinearLayout
                android:id="@+id/lib_sel_bar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_lib_sel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/pink"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btn_lib_del_sel"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@null"
                    android:contentDescription="@string/lib_delete_sel"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/pink"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btn_lib_cancel_sel"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@null"
                    android:contentDescription="@string/lib_cancel_sel"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_card2"
                android:drawableLeft="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_dim"
                android:hint="搜索标题或UP主"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_play_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/ripple_round"
                    android:drawableLeft="@drawable/ic_play"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/pink"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="播放全部"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/list_tracks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@color/divider"
                    android:dividerHeight="0.5dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingBottom="12dp"
                    android:scrollbarStyle="outsideOverlay" />

                <TextView
                    android:id="@+id/empty_tracks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/empty_tracks"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ page: playlists ============ -->
        <LinearLayout
            android:id="@+id/page_playlists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="8dp">

                <TextView
                    style="@style/TitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_playlists" />

                <ImageButton
                    android:id="@+id/btn_new_pl"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_dark"
                    android:contentDescription="新建歌单"
                    android:src="@drawable/ic_add"
                    android:tint="@color/text" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/list_playlists"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@color/divider"
                    android:dividerHeight="0.5dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingBottom="12dp"
                    android:scrollbarStyle="outsideOverlay" />

                <TextView
                    android:id="@+id/empty_playlists"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/empty_playlists"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ============ page: recent ============ -->
        <LinearLayout
            android:id="@+id/page_recent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingLeft="18dp">

                <TextView
                    style="@style/TitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_recent" />
            </LinearLayout>

            <ListView
                android:id="@+id/list_recent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/divider"
                android:dividerHeight="0.5dp"
                android:listSelector="@android:color/transparent" />

            <TextView
                android:id="@+id/empty_recent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/empty_recent"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ page: me ============ -->
        <ScrollView
            android:id="@+id/page_me"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:paddingLeft="18dp">

                    <TextView
                        style="@style/TitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_settings" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:background="@drawable/shape_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_cached"
                        android:tint="@color/pink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storage_usage"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_cache"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="计算中..."
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_clear_cache"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/ripple_round"
                        android:minWidth="0dp"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="清除"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_settings"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/text_sub" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:text="设置"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_next"
                        android:tint="@color/text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_update"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download"
                        android:tint="@color/text_sub" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检查更新 / 下载最新版"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_update"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="更新源：GitHub（始终最新版）"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_next"
                        android:tint="@color/text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_backup"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_download"
                        android:tint="@color/text_sub" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="备份数据"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="曲库、歌单、最近播放导出为 JSON 到下载目录"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_restore"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/text_sub" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="恢复备份"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="从备份 JSON 文件导入（合并到现有数据）"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_open_cache"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/shape_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cached"
                        android:tint="@color/text_sub" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="打开缓存文件夹"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_cache_path"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:text="查看已下载的音频文件"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:layout_marginTop="16dp"
                    android:text="从B站复制视频链接 → 分享到本App（或点曲库页 + 粘贴）\n仅个人自用，音频来源 bilibili"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ mini player ============ -->
    <FrameLayout
        android:id="@+id/mini_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mini"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_mini"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="8dp">

        <ImageView
            android:id="@+id/mini_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_card2"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mini_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

            <ProgressBar
                android:id="@+id/mini_load"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/mini_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play"
                android:tint="@color/text" />

            <ImageButton
                android:id="@+id/mini_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="下一首"
                android:src="@drawable/ic_next"
                android:tint="@color/text_sub" />
        </LinearLayout>

        <View
            android:id="@+id/mini_prog"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|start"
            android:background="@color/pink" />
    </FrameLayout>

    <!-- ============ bottom nav ============ -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_nav"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_tracks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_tracks"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_library"
                android:tint="@color/pink" />

            <TextView
                style="@style/TabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_tracks"
                android:textColor="@color/pink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_playlists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_playlists"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_queue"
                android:tint="@color/text_dim" />

            <TextView
                style="@style/TabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_playlists" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_recent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_recent"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_history"
                android:tint="@color/text_dim" />

            <TextView
                style="@style/TabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_recent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_me"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_me"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_dim" />

            <TextView
                style="@style/TabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
